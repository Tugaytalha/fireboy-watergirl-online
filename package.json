{
  "name": "fireboy-watergirl-online",
  "version": "1.0.0",
  "private": true,
  "description": "Cooperative puzzle-platformer inspired by Fireboy & Watergirl — local + online co-op",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w shared && npm run build -w client && npm run build -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "test": "npm run test -w shared -w client -w server --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,html}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
